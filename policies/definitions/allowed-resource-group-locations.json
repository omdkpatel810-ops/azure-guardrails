{
  "name": "guardrails-allowed-rg-locations",
  "properties": {
    "displayName": "Guardrails: resource groups only in allowed regions",
    "description": "Denies resource groups outside the allowed regions, so their metadata also stays in Canada.",
    "mode": "All",
    "metadata": { "category": "General", "version": "1.0.0" },
    "parameters": {
      "allowedLocations": {
        "type": "Array",
        "metadata": { "displayName": "Allowed locations", "strongType": "location" },
        "defaultValue": ["canadacentral", "canadaeast"]
      },
      "effect": {
        "type": "String",
        "metadata": { "displayName": "Effect" },
        "allowedValues": ["Deny", "Audit", "Disabled"],
        "defaultValue": "Deny"
      }
    },
    "policyRule": {
      "if": {
        "allOf": [
          { "field": "type", "equals": "Microsoft.Resources/subscriptions/resourceGroups" },
          { "field": "location", "notIn": "[parameters('allowedLocations')]" }
        ]
      },
      "then": { "effect": "[parameters('effect')]" }
    }
  }
}
